' All subroutine scratch variables have distinct prefixes: BASIC scalars are global.
sub root(n)
  rootLo = 0
  rootHi = 256
  while rootLo + 1 < rootHi
    rootMid = (rootLo + rootHi) \ 2
    if rootMid * rootMid <= n then
      rootLo = rootMid
    else
      rootHi = rootMid
    end if
  wend
  rootValue = rootLo
end sub

' Integer point-to-segment disk test; inputs here stay within the 128-tile board.
sub disk(ax, ay, bx, by, cx, cy, radius)
  diskDx = bx - ax
  diskDy = by - ay
  diskLen = diskDx * diskDx + diskDy * diskDy
  diskX = cx - ax
  diskY = cy - ay
  diskDot = diskX * diskDx + diskY * diskDy
  diskHit = 0
  if diskDot <= 0 then
    if diskX * diskX + diskY * diskY <= radius * radius then diskHit = 1
  elseif diskDot >= diskLen then
    diskX = cx - bx
    diskY = cy - by
    if diskX * diskX + diskY * diskY <= radius * radius then diskHit = 1
  else
    diskCross = diskX * diskDy - diskY * diskDx
    if diskCross * diskCross <= radius * radius * diskLen then diskHit = 1
  end if
end sub

sub throwAt(tx, ty, recipient)
  shotAccepted = 0
  if thrown = 1 or hookReady = 0 or (selfHooked = 1 and heldThrow = 0) then exit sub
  if tx < 8 then tx = 8
  if tx > 119 then tx = 119
  if ty < 8 then ty = 8
  if ty > 119 then ty = 119
  shotDx = tx - originX
  shotDy = ty - originY
  root(shotDx * shotDx + shotDy * shotDy)
  if rootValue = 0 then exit sub
  shotX = tx
  shotY = ty
  if rootValue > reach then
    shotX = originX + shotDx * reach \ rootValue
    shotY = originY + shotDy * reach \ rootValue
  end if
  ' Doubled coordinates represent the exact fountain center and radius.
  ' A specialized cross-product test avoids squaring doubled segment lengths.
  fountainDx = shotX - originX
  fountainDy = shotY - originY
  fountainX = 129 - 2 * originX
  fountainY = 129 - 2 * originY
  fountainLen = fountainDx * fountainDx + fountainDy * fountainDy
  fountainDot = fountainX * fountainDx + fountainY * fountainDy
  fountainBlocked = 0
  if fountainDot <= 0 then
    if fountainX * fountainX + fountainY * fountainY <= 49 then fountainBlocked = 1
  elseif fountainDot >= 2 * fountainLen then
    fountainX = 129 - 2 * shotX
    fountainY = 129 - 2 * shotY
    if fountainX * fountainX + fountainY * fountainY <= 49 then fountainBlocked = 1
  else
    fountainCross = fountainX * fountainDy - fountainY * fountainDx
    if fountainCross * fountainCross <= 49 * fountainLen then fountainBlocked = 1
  end if
  if fountainBlocked = 1 then exit sub
  for shotI = 0 to count - 1
    if alive(shotI) = 1 and team(shotI) = selfTeam and ids(shotI) <> selfId and ids(shotI) <> recipient and selfHooked = 0 then
      if shield(shotI) = 0 then
        disk(originX, originY, shotX, shotY, px(shotI), py(shotI), clearance)
        if diskHit = 1 and (laneBeyond = 0 or diskDot < diskLen) then exit sub
        disk(originX, originY, shotX, shotY, px(shotI) + vx(shotI) \ 2, py(shotI) + vy(shotI) \ 2, clearance)
        if diskHit = 1 and (laneBeyond = 0 or diskDot < diskLen) then exit sub
      end if
    end if
  next shotI
  if rescueRequest = 1 then
    shotAccepted = rescueAlly(recipient)
  else
    shotAccepted = hookTo(tx, ty)
  end if
  if shotAccepted = 1 then
    thrown = 1
    castX = tx
    castY = ty
    castRecipient = recipient
  end if
end sub

sub throwRune(runeIndex)
  runeAimX = runeX(runeIndex)
  runeAimY = runeY(runeIndex)
  runeDirection = 1
  if runeNextY = 16 then runeDirection = -1
  if runeCount() > 1 then
    if runeIndex < runeCount() - 1 then runeDirection = 0 - runeDirection
  else
    runeNewestKind = runeNextKind
    runeNewestStart = 16
    runeOlderStart = 111
    if runeNextY = 16 then
      runeNewestKind = (runeNextKind + 5) mod 6
      runeNewestStart = 111
      runeOlderStart = 16
    end if
    if runeKind(runeIndex) <> runeNewestKind then
      runeDirection = 0 - runeDirection
    else
      runeNewestY = runeNewestStart * 8 + 4 + runeDirection * (641 - runeSoon)
      runeOlderY = runeOlderStart * 8 + 4 - runeDirection * (1281 - runeSoon)
      runeNewestGap = runeAimY * 8 + 4 - runeNewestY
      runeOlderGap = runeAimY * 8 + 4 - runeOlderY
      if runeNewestGap < 0 then runeNewestGap = 0 - runeNewestGap
      if runeOlderGap < 0 then runeOlderGap = 0 - runeOlderGap
      runeGapDifference = runeNewestGap - runeOlderGap
      if runeGapDifference < 0 then runeGapDifference = 0 - runeGapDifference
      if runeGapDifference <= 8 then
        runeDirection = 0
      elseif runeOlderGap < runeNewestGap then
        runeDirection = 0 - runeDirection
      end if
    end if
  end if
  if runeSoon <= 0 then runeDirection = 0
  for runeRefine = 0 to 1
    runeSpanX = runeAimX - originX
    runeSpanY = runeAimY - originY
    root(runeSpanX * runeSpanX + runeSpanY * runeSpanY)
    runeDistance = rootValue * 100
    runeTravel = 50
    runeFlight = 0
    runeSpeed = 60 + 3 * speedLevel
    if selfBuff = 5 then runeSpeed = runeSpeed * 2
    while runeTravel < runeDistance and runeFlight < 100
      if runeSpeed < 180 then
        runeSpeed = runeSpeed + 3
        if runeSpeed > 180 then runeSpeed = 180
      end if
      runeTravel = runeTravel + runeSpeed
      runeFlight = runeFlight + 1
    wend
    runeAimY = runeY(runeIndex) + runeDirection * ((runeFlight + 13) \ 8)
  next runeRefine
  throwAt(runeAimX, runeAimY, 0)
end sub

sub moveTo(mx, my)
  if mx < 8 then mx = 8
  if mx > 119 then mx = 119
  if my < 8 then my = 8
  if my > 119 then my = 119
  walkTo(mx, my)
end sub

' Clip a perpendicular integer ray to the own-bank rectangle, preserving direction.
sub curveEnd(cx, cy)
  curveScale = 1024
  if cx > 0 and selfX + cx > curveMaxX then curveScale = (curveMaxX - selfX) * 1024 \ cx
  if cx < 0 and selfX + cx < curveMinX then curveScale = (curveMinX - selfX) * 1024 \ cx
  if cy > 0 and selfY + cy > 111 then
    curveYScale = (111 - selfY) * 1024 \ cy
    if curveYScale < curveScale then curveScale = curveYScale
  end if
  if cy < 0 and selfY + cy < 16 then
    curveYScale = (16 - selfY) * 1024 \ cy
    if curveYScale < curveScale then curveScale = curveYScale
  end if
  curveEndX = selfX + cx * curveScale \ 1024
  curveEndY = selfY + cy * curveScale \ 1024
  curveStep = (curveEndX - selfX) * (curveEndX - selfX) + (curveEndY - selfY) * (curveEndY - selfY)
end sub

