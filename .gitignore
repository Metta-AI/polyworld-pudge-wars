# Ignore files with no extention.
*
!*/
!*.*
!LICENSE
!Dockerfile

# Ignore hidden files, but not the license or github files.
.*
!.github/
!.github/**
!.gitignore
!.dockerignore

# Normal ignores.
nim.cfg
*.exe
nimcache
*.pdb
*.ilk
*.out
.env
.env.local
__pycache__/
*.pyc
dist/
build/

# Assets live in ./polyworld_data in this snapshot (or a sibling clone).
/data
/polyworld_data/

# Nimby writes a workspace nim.cfg (no extension) and may clone packages
# into this folder. Never commit those checkouts.
/silky/
/pixie/
/vmath/
/chroma/
/zippy/
/flatty/
/nimsimd/
/bumpy/
/crunchy/
/shady/
/windy/
/opengl/
/urlly/
/ws/
/dx12/
/vk14/
/metal4/
/jsony/
/fluffy/
/gltf/
/webby/
/noisy/
/benchy/
/openal/
/mummy/
/whisky/
/chrono/
/puppy/
/supersnappy/
/libcurl/

# Project specific ignores.
*.atlas.png
!polyworld_data/**/*.atlas.png
experiments/terrain/quadterrain_shot.png
experiments/characters/characters_shot.png
examples/gods_of_the_arena/gota_shot.png
examples/gods_of_the_arena/emscripten/
examples/gods_of_the_arena/profiles/
examples/call_to_adventure/shot.png
examples/call_to_adventure/emscripten/
examples/light_vs_dark/*.png
examples/light_vs_dark/emscripten/
examples/light_vs_dark/profiles/
examples/pudge_wars/pw_shot.png
examples/pudge_wars/emscripten/
examples/pudge_wars/profiles/
examples/pudge_wars/duels/
examples/pudge_wars/macos/*.app/
examples/hook_royale/emscripten/
examples/hook_royale/profiles/
/duels/
/hr
/pw
/hrheadless
tmp/
/.env.local
experiments/modular_chars/modular_chars_shot.png

# Pudge Wars web build output (regenerated by nim c -d:emscripten)
/examples/pudge_wars/emscripten/

# Private 2v2 teammate policy — never commit these.
examples/pudge_wars/players/partner.bas
examples/pudge_wars/squad/
examples/pudge_wars/squad.sh
examples/pudge_wars/squad_lab.sh
examples/pudge_wars/squad_spar.sh
/outputs/
